{
  "name": "mechanical-frontier",
  "version": "1.0.0",
  "private": true,
  "description": "Mechanical Frontier desktop game",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.52.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.mechanicalfrontier.game",
    "productName": "Mechanical Frontier",
    "asar": false,
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "next.config.ts",
      "postcss.config.mjs",
      "tsconfig.json",
      "drizzle.config.json",
      "!node_modules/.cache/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/electron-builder-squirrel-windows/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Mechanical-Frontier-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mechanical Frontier",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
